@'
# Dependencies
/node_modules
/client/node_modules
/backend/node_modules

# Environment variables
.env
.env.*
client/.env
backend/.env

# Build output
/dist
/build
/client/dist
/client/build

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / Editor specific
.vscode/
.idea/
'@ | Out-File -FilePath .gitignore -Encoding utf8